DATABASE_URL="file:./data/dev.db"

# M5 — email reminders (req 08). Gmail/Google Workspace SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Where reminder emails are sent (the salesperson's own inbox — never the customer).
REMINDER_TO_EMAIL=
# Shared secret the cron trigger (POST /api/cron/reminders) checks via an
# `Authorization: Bearer <value>` header.
CRON_SECRET=
# Base URL used to build the deal links inside reminder emails.
APP_BASE_URL=http://localhost:3000

# Password for the login screen. Required in production (the app returns 503 without it); optional locally.
APP_PASSWORD=
